{
  "name": "xyz.js",
  "version": "1.7.0",
  "description": "Browser-native TypeScript game engine",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@webgpu/types": "0.1.74",
    "eslint": "10.11.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/minify-dist.mjs && node scripts/copy-vendor.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "examples": "vite --host 127.0.0.1 --open /examples/",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "smoke:examples": "node scripts/smoke-examples.mjs",
    "check:tree-shaking": "node scripts/check-tree-shaking.mjs",
    "docs:api": "typedoc"
  }
}